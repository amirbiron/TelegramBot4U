# ─────────────────────────────────────────────────────────────────────────
# בוט ה-Secretary — משתני סביבה
#
# הקובץ הזה מתעדכן בכל commit שמוסיף משתנה סביבה (כלל ב-CLAUDE.md).
# העתיקו ל-.env ומלאו. משתנים פר-tenant (טוקן בוט-בן וכו') **אינם** כאן —
# הם נשמרים מוצפנים ב-control plane (tenant_secrets).
# ─────────────────────────────────────────────────────────────────────────

# ─── אחסון ───────────────────────────────────────────────────────────────
# תיקיית הנתונים. ב-Render — נתיב של disk קבוע.
# תחתיה: platform.db (control plane) + tenants/<slug>/chatbot.db (data plane)
DATA_DIR=./data
# נתיב ה-DB של ה-tenant של ברירת המחדל (legacy / פיתוח מקומי)
DB_PATH=./data/chatbot.db

# ─── multi-tenant ────────────────────────────────────────────────────────
# true בפרודקשן: גישה ל-DB בלי tenant context קובע ⇒ חריגה (fail-loud).
TENANCY_STRICT=false

# ─── סודות ───────────────────────────────────────────────────────────────
# מפתח Fernet להצפנת סודות ה-tenants. חובה בפרודקשן — בלעדיו כתיבת
# סודות פלטפורמה נחסמת (fail-closed). **חייב** להיות מפתח Fernet אמיתי;
# סיסמה חופשית נדחית בעליית התהליך ולא נגזרת למפתח.
# ייצור: python -m platform_cli gen-key
SECRETS_ENCRYPTION_KEY=
# pepper ל-consent_ledger (HMAC של subject_hash). חי בנפרד מ-DB ומהמפתח למעלה.
# ייצור: python -c "import secrets; print(secrets.token_urlsafe(32))"
LEDGER_PEPPER_V1=

# ─── טלגרם ───────────────────────────────────────────────────────────────
# הבוט המנהל (Bot Management Mode ב-BotFather) — שלב 2.
MANAGER_BOT_TOKEN=
MANAGER_BOT_USERNAME=
# הבוט הידני של שלב 1 (בוט אחד, tenant יחיד, Secretary Mode דלוק ב-BotFather).
TELEGRAM_BOT_TOKEN=
# בסיס ה-URL הציבורי שאליו טלגרם שולחת webhooks (בלי / בסוף).
# ה-route של בוט-בן: <WEBHOOK_BASE_URL>/telegram/webhook/t/<key>
WEBHOOK_BASE_URL=
# סוד לאימות הכותרת X-Telegram-Bot-Api-Secret-Token של הבוט המנהל.
# לבוטים-בנים הסוד נשמר פר-tenant ב-tenant_secrets.
MANAGER_WEBHOOK_SECRET=

# ─── LLM ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# base URL חלופי לספק תואם-OpenAI (למשל Gemini). ריק = OpenAI.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
# מודל קל לסיווג כוונות
INTENT_MODEL=gpt-4.1-nano
# כבוי כברירת מחדל — הכוונה משמשת לתיוג בלבד בערוץ הזה (ראה intent.py)
LLM_INTENT_ENABLED=false
LLM_MAX_TOKENS=2048
# בורר ספק ברמת הפלטפורמה: ריק = OpenAI/Gemini, 'claude' = Anthropic.
# ‏tenant עם סוד anthropic_api_key משלו עובר ל-Claude אוטומטית.
LLM_PROVIDER=
LLM_MODEL=
# Anthropic — ספק חלופי פר-tenant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# ‏timeout לקריאת LLM יוצאת (שניות). בלעדיו ה-SDK ממתין דקות, ובינתיים
# ההודעה של הלקוח תקועה וטלגרם שולחת את העדכון שוב.
LLM_TIMEOUT_SECONDS=45
# סיווג כוונה הוא תיוג בלבד — timeout קצר יותר בכוונה
INTENT_TIMEOUT_SECONDS=8

# ─── שיחה ────────────────────────────────────────────────────────────────
# כמה הודעות היסטוריה נכנסות לפרומפט
CONTEXT_WINDOW_SIZE=10
# מכמה הודעות לא-מסוכמות מתחיל סיכום שיחה
SUMMARY_THRESHOLD=10
# סף אזהרה לגודל בסיס הידע (טוקנים) — מעליו הפאנל מציג אזהרה
KB_TOKEN_WARN_THRESHOLD=50000
# אחרי כמה דקות בלי הודעת בעלים הבוט חוזר לענות בצ'אט מושתק
TAKEOVER_TIMEOUT_MINUTES=120

# ─── זיכרון לקוחות ───────────────────────────────────────────────────────
BUSINESS_ID=default
MEMORY_INJECTION_ENABLED=true
# מעל כמה ימים עובדת זיכרון מסומנת "ייתכן שלא רלוונטי"
MEMORY_STALENESS_DAYS=90

# ─── דגלי פיצ'רים ────────────────────────────────────────────────────────
# הזרמה הדרגתית של התשובה (sendMessageDraft). כבוי — ראה V4 ב-
# docs/verification_log.md
HUMANIZED_DELIVERY=false

# ─── מגבלות קצב (פר tenant+משתמש) ────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=50
RATE_LIMIT_PER_DAY=100

# ─── פאנל אדמין ──────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# עדיף ADMIN_PASSWORD_HASH (werkzeug generate_password_hash) על סיסמה גלויה
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# חובה — חתימת sessions ו-CSRF
ADMIN_SECRET_KEY=
ADMIN_HOST=0.0.0.0
ADMIN_PORT=5000
# עוגיית ה-session נשלחת ב-HTTPS בלבד. כבה **רק** לפיתוח מקומי על http;
# בפרודקשן כיבוי חושף את ה-session לגניבה ברשת.
ADMIN_COOKIE_SECURE=true

# ─── זהות עסקית (ברירת מחדל ל-tenant ה-legacy) ───────────────────────────
# ל-tenants בפלטפורמה השם מגיע מ-display_name ב-control plane.
BUSINESS_NAME=
BUSINESS_PHONE=
BUSINESS_ADDRESS=
BUSINESS_WEBSITE=

# ─── ניטור ───────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
